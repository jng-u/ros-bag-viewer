{
  "name": "ros-web-viewer",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.5",
  "scripts": {
    "dev": "corepack pnpm --filter @ros-web-viewer/web dev",
    "build:web": "corepack pnpm build && corepack pnpm --filter @ros-web-viewer/web build:web",
    "lint": "eslint .",
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:toolchain": "vitest run tests/toolchain/smoke.test.ts tests/toolchain/release-readiness.test.ts",
    "pretest:unit": "corepack pnpm build && node apps/web/scripts/generate-demo-mcap.mjs",
    "test:unit": "vitest run --passWithNoTests",
    "test:integration": "vitest run tests/m1/vertical-slice.test.ts packages/m2-recorded-gate/test/index.test.ts packages/source-hosted/test/index.test.ts tests/m4-hosted/lifecycle.test.ts",
    "test:security": "vitest run tests/m0/baseline.test.ts -t 'approval evidence|paid-infrastructure' && vitest run tests/m3-live/security-gate.test.ts packages/hosted-core/test/index.test.ts tests/m4-hosted/lifecycle.test.ts",
    "test:e2e": "vitest run tests/m1/vertical-slice.test.ts packages/m2-recorded-gate/test/index.test.ts tests/m4-hosted/lifecycle.test.ts apps/web/test/hosted-adapter.test.ts",
    "test:e2e:browser": "node apps/web/scripts/browser-e2e.mjs",
    "test:e2e:live-bridge": "node apps/web/scripts/live-bridge-browser-e2e.mjs",
    "test:a11y": "vitest run tests/m0/baseline.test.ts -t 'accessibility'",
    "test:ux": "vitest run tests/m0/baseline.test.ts -t 'desktop UX baseline'",
    "bench:micro": "node benchmarks/scenarios/run-m1-dimensional.mjs",
    "bench:corpus": "node benchmarks/scenarios/run-m1-dimensional.mjs",
    "bench:public:browser": "node benchmarks/scenarios/run-public-browser.mjs",
    "bench:public:check": "node benchmarks/scenarios/check-public-browser-artifact.mjs",
    "bench:public:ros2:browser": "node benchmarks/scenarios/run-public-ros2-browser.mjs",
    "bench:public:ros2:check": "node benchmarks/scenarios/check-public-ros2-browser-artifact.mjs",
    "build": "tsc -b",
    "check:m0": "vitest run tests/m0/baseline.test.ts",
    "check:m1": "vitest run tests/m1",
    "check:m2": "vitest run packages/m2-recorded-gate/test/index.test.ts packages/source-ros1bag/test/index.test.ts packages/source-ros2-sqlite/test/index.test.ts packages/displays-core/test/index.test.ts",
    "check:m3": "vitest run tests/m3-live",
    "check:m4": "vitest run packages/hosted-core/test/index.test.ts packages/source-hosted/test/index.test.ts tests/m4-hosted/lifecycle.test.ts apps/web/test/hosted-adapter.test.ts",
    "check:m4:hosted-core": "vitest run packages/hosted-core/test/index.test.ts",
    "check:m5": "vitest run packages/extension-api/test/index.test.ts packages/protocol/test/canonical.test.ts packages/protocol/test/conformance-v1.test.ts tests/toolchain/release-readiness.test.ts",
    "release:readiness": "node scripts/toolchain/release-readiness-gate.mjs",
    "release:readiness:full": "node scripts/toolchain/release-readiness-gate.mjs --check-reproducibility --check-clean-tree",
    "evidence:semantic": "corepack pnpm --filter @ros-web-viewer/web evidence:semantic",
    "evidence:m3": "UPDATE_M3_EVIDENCE=1 vitest run --config tests/m3-live/vitest.config.ts tests/m3-live/generate-evidence.test.ts",
    "evidence:v1": "node scripts/toolchain/conformance-execution-manifest.mjs",
    "audit:dependencies": "corepack pnpm audit --audit-level high",
    "report:licenses": "node scripts/toolchain/licenses-report.mjs",
    "sbom": "node scripts/toolchain/sbom-report.mjs"
  },
  "devDependencies": {
    "@mcap/core": "2.2.1",
    "@eslint/js": "10.0.1",
    "@types/node": "^22.10.0",
    "eslint": "10.9.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
